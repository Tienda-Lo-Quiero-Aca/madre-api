# Servicio
PORT=3000
INTERNAL_API_KEY=
# MADRE_BODY_LIMIT=10mb

# Sitio de documentacion (README + docs/). Sin usuario y clave queda abierto y
# no publica la pagina de operacion; con los dos pide credenciales y publica todo.
DOCS_SITE_ENABLED=true
DOCS_SITE_PATH=/docs
# DOCS_SITE_USER=
# DOCS_SITE_PASSWORD=

# Base de datos principal
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Base de impuestos y productos de la tienda web
TAXES_DB_HOST=
TAXES_DB_PORT=3306
TAXES_DB_USERNAME=
TAXES_DB_PASSWORD=
TAXES_DB_DATABASE=tlq

# Redis (siempre con TLS). Sin host y puerto el servicio no arranca.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# Sincronizaciones del catalogo
AUTOMELI_BASE_URL=
